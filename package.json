{
  "name": "@substrate-system/a11y",
  "description": "Accessibility helpers",
  "directories": {
    "example": "example",
    "test": "test"
  },
  "type": "module",
  "version": "0.0.17",
  "main": "dist/index.css",
  "files": [
    "./dist/*"
  ],
  "scripts": {
    "start": "vite",
    "lint": "npm run stylelint",
    "stylelint": "stylelint src/*.css",
    "build-css": "node -e \"const fs=require('node:fs');const {transform}=require('lightningcss');for(const f of fs.readdirSync('src').filter(f=>f.endsWith('.css'))){const out=transform({filename:f,code:fs.readFileSync('src/'+f)}).code;fs.writeFileSync('dist/'+f,out)}\"",
    "build-css:min": "node -e \"const fs=require('node:fs');const {transform}=require('lightningcss');for(const f of fs.readdirSync('src').filter(f=>f.endsWith('.css'))){const out=transform({filename:f,code:fs.readFileSync('src/'+f),minify:true}).code;fs.writeFileSync('dist/'+f.replace(/\\\\.css$/,'.min.css'),out)}\"",
    "build": "mkdir -p ./dist && rm -rf ./dist/* && npm run build-css && npm run build-css:min && npm run build:index && npm run build-index:min",
    "build:index": "node -e \"const fs=require('node:fs');const {transform}=require('lightningcss');const css=fs.readdirSync('src').filter(f=>f.endsWith('.css')).map(f=>fs.readFileSync('src/'+f)).join('\\n');const out=transform({filename:'index.css',code:Buffer.from(css)}).code;fs.writeFileSync('dist/index.css',out)\"",
    "build-index:min": "node -e \"const fs=require('node:fs');const {transform}=require('lightningcss');const out=transform({filename:'index.css',code:fs.readFileSync('dist/index.css'),minify:true}).code;fs.writeFileSync('dist/index.min.css',out)\"",
    "build-example": "mkdir -p ./public && rm -rf ./public/* && vite --mode staging --base=\"/a11y\" build",
    "preversion": "npm run stylelint",
    "toc": "markdown-toc --maxdepth 3 -i README.md",
    "version": "npm run toc && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && git add CHANGELOG.md README.md",
    "postversion": "git push --follow-tags && npm publish",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": "./dist/index.css",
    "./*.css": "./dist/*.css",
    "./reduced-motion": "./dist/reduced-motion.css",
    "./visually-hidden": "./dist/visually-hidden.css",
    "./min": "./dist/index.min.css",
    "./min/*": "./dist/*.min.css",
    "./css": "./dist/index.css",
    "./css/*": "./dist/*.css",
    "./css/min/*": "./dist/*.min.css",
    "./*": "./dist/*.css"
  },
  "devDependencies": {
    "auto-changelog": "^2.4.0",
    "lightningcss": "^1.32.0",
    "markdown-toc": "^1.2.0",
    "stylelint": "^17.1.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.0"
  },
  "author": "nichoth <nichoth@nichoth.com> (https://nichoth.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/substrate-system/a11y.git"
  },
  "keywords": [
    "a11y",
    "accessibility"
  ],
  "bugs": {
    "url": "https://github.com/substrate-system/a11y/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/substrate-system/a11y"
}
